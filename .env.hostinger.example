# ───────────────────────────────────────────────────────────────────────────
# RistoReel (ristoreel.it) — Template di Produzione per Hostinger (hPanel)
# Inserisci queste variabili nella sezione "Variabili d'ambiente" dell'app
# Node.js su Hostinger hPanel (oppure salvale come .env nella root di sorgente).
# ───────────────────────────────────────────────────────────────────────────

NODE_ENV=production
APP_URL=https://ristoreel.it
AUTH_URL=https://ristoreel.it
NEXT_PUBLIC_BRAND_NAME=RistoReel
NEXT_PUBLIC_PROMO_BAR=
NEXT_PUBLIC_PROMO_HREF=/pricing

# Auth.js & Email (Resend con dominio ristoreel.it verificato) ----------------
# Genera con: openssl rand -base64 32
AUTH_SECRET=SOSTITUISCI_CON_SECRET_CASUALE_32_BYTE
AUTH_RESEND_KEY=re_SOSTITUISCI_CON_RESEND_API_KEY
EMAIL_FROM="RistoReel <login@ristoreel.it>"
SUPPORT_EMAIL=support@ristoreel.it
SIGNUP_BONUS_CREDITS=0
ADMIN_EMAILS=admin@ristoreel.it
BLOCK_DISPOSABLE_EMAIL=true

# Database MongoDB Atlas (Replica Set obbligatorio per le transazioni) --------
MONGODB_URI=mongodb+srv://utente:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ristoreel-prod

# API Video AI Higgsfield ----------------------------------------------------
HF_API_BASE_URL=https://api.higgsfield.ai
HF_CREDENTIALS=key_id:key_secret
# Genera con: openssl rand -hex 32
HF_WEBHOOK_SECRET=SOSTITUISCI_CON_HEX_64_CARATTERI
HF_WEBHOOK_BASE_URL=https://ristoreel.it
HF_PRICE_GUARD=true
RUN_TIMEOUT_MINUTES=30

# Regola Commerciale Ristorazione (1,5x sul costo API) -----------------------
RESTAURANT_MODE=true
CREDIT_MARKUP=1.5
CREDIT_USD_VALUE=0.01

# Pagamenti Stripe in Euro (€) -----------------------------------------------
# Webhook Stripe da puntare a: https://ristoreel.it/api/webhooks/stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Prezzi Abbonamenti in EUR (€): Trattoria (12€/9,60€), Ristorante (35€/28€), Gruppo (89€/71,20€)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PLUS_MONTHLY=price_...
STRIPE_PRICE_PLUS_ANNUAL=price_...
STRIPE_PRICE_ULTRA_MONTHLY=price_...
STRIPE_PRICE_ULTRA_ANNUAL=price_...

# Prezzi Ricariche a Consumo in EUR (€): Servizio (5€), Menù (20€), Stagione (50€)
STRIPE_PRICE_TOPUP_SMALL=price_...
STRIPE_PRICE_TOPUP_MEDIUM=price_...
STRIPE_PRICE_TOPUP_LARGE=price_...

# Storage Video Permanente (Cloudflare R2) -----------------------------------
# Consigliato sottodominio custom: https://media.ristoreel.it
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ristoreel-media
R2_PUBLIC_BASE_URL=https://media.ristoreel.it

# Sicurezza Cron Riconciliazione (/api/cron/reconcile) -----------------------
# Genera con: openssl rand -hex 32
CRON_SECRET=SOSTITUISCI_CON_SECRET_CRON
